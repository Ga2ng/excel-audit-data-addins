{
  "name": "excel-audit-data-tools",
  "version": "0.1.0",
  "private": true,
  "description": "Excel Audit Data Tools - Microsoft Excel Office Add-in to parse selected table ranges into JSON",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "start": "node scripts/start.mjs",
    "dev": "node scripts/start.mjs --no-excel",
    "stop": "node scripts/stop.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 47136 --strictPort",
    "certs": "office-addin-dev-certs install"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/office-js": "^1.0.368",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "office-addin-dev-certs": "^1.13.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.4",
    "typescript": "^5.5.2",
    "vite": "^5.3.1"
  }
}
